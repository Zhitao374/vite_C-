{
  "name": "cpp-course",
  "version": "3.0.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "npm run dev",
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:vite": "vite build",
    "build": "npm run build:vite && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js",
    "format": "prettier --write src",
    "help": "node scripts/help.js"
  },
  "build": {
    "appId": "com.cpp.course",
    "productName": "CppCourse",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/compiler",
        "to": "compiler"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "execa": "^10.2.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.4.0",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "prettier": "^3.2.0",
    "vite": "^5.0.0",
    "wait-on": "^9.5.1"
  }
}