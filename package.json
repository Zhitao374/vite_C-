{
  "name": "cpp-course",
  "version": "3.0.0",
  "type": "module",
  "main": "electron-main.js",
  "overrides": {
    "bluebird": "3.7.2"
  },
  "scripts": {
    "start": "npm run dev",
    "dev:vite": "vite",
    "dev:electron": ".\\my-electron\\electron.exe .",
    "dev": "concurrently \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:vite": "vite build",
    "build": "cross-env ELECTRON_BUILDER_CACHE=C:\\electron_cache npm run build:vite && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js",
    "format": "prettier --write src",
    "help": "node scripts/help.js"
  },
  "build": {
    "appId": "com.cpp.course",
    "productName": "CppCourse",
    "electronDist": "my-electron",
    "electronVersion": "30.5.1",
    "asar": false,
    "files": [
      "dist/**/*",
      "electron-main.js",
      "electron-preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/compiler",
        "to": "compiler"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "execa": "^8.0.1",
    "katex": "^0.16.9",
    "lucide-vue-next": "^0.562.0",
    "vue": "^3.4.0",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "prettier": "^3.2.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}